{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

brew bundle --file=/dev/stdin <<EOF
brew "aria2"
brew "atuin"
brew "bat"
brew "chezmoi"
brew "curl"
brew "fd"
brew "fish"
brew "fisher"
brew "git"
brew "mise"
brew "neovim"
brew "ripgrep"
brew "ruby-build"
brew "tree-sitter"
brew "tree"
brew "xcodesorg/made/xcodes"
brew "zoxide"
cask "keepassxc"
EOF

fish -c 'fisher install IlanCosman/tide'
fish -c 'fisher install lucasadelino/tide-item-jj'
fish -c 'set -U tide_left_prompt_items pwd vcs newline character'

{{ end -}}
